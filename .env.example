# Copy to .env and fill in. .env is git-ignored. Real environment variables win over this file.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# The WordPress site and a user's Application Password
# (wp-admin > Users > Profile > Application Passwords). Use HTTPS for real sites.
WP_BASE_URL=https://example.com
WP_USERNAME=
WP_APP_PASSWORD=

# Where the JSON-lines audit log of every publish goes
PUBLISH_LOG=out/publish-log.jsonl
